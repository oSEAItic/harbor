FROM golang:1.23 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/harbor-gateway ./gateway

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /out/harbor-gateway /harbor-gateway
EXPOSE 8080
ENV PORT=8080
ENTRYPOINT ["/harbor-gateway"]
